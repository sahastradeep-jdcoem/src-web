rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Authentication & Ownership Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUserOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Safety fallback for primary college administrators
    function isHardcodedAdmin() {
      return isAuthenticated() && request.auth.token.email in [
        'shendeha@jdcoem.ac.in',
        'studentrepresentcouncil@jdcoem.ac.in',
        'harshshende0718@gmail.com',
        'harshxfr@gmail.com',
        'admin@jdcoem.ac.in',
        'src.president@jdcoem.ac.in',
        'src.mentor@jdcoem.ac.in',
        'src.gensec@jdcoem.ac.in'
      ];
    }

    // Retrieve user's official college BT ID from /users/{uid}
    function getUserBtId() {
      return (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.btId
        : null;
    }

    // Retrieve active role assignment from /admin_access keyed by UID, BT ID, or Email
    function getAdminAccess() {
      return (isAuthenticated() && exists(/databases/$(database)/documents/admin_access/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/admin_access/$(request.auth.uid)).data
        : (
          (getUserBtId() != null && exists(/databases/$(database)/documents/admin_access/$(getUserBtId())))
            ? get(/databases/$(database)/documents/admin_access/$(getUserBtId())).data
            : (
              (request.auth.token.email != null && exists(/databases/$(database)/documents/admin_access/$(request.auth.token.email)))
                ? get(/databases/$(database)/documents/admin_access/$(request.auth.token.email)).data
                : null
            )
        );
    }

    // Check specific role assignment and ensure it is not deactivated
    function hasRole(roleName) {
      return getAdminAccess() != null &&
        getAdminAccess().role == roleName &&
        getAdminAccess().active != false;
    }

    // Full system Owner identity (break-glass emails, Firestore OWNER role, or appointed Council Admin)
    function isOwner() {
      return isAuthenticated() && (
        request.auth.token.email in [
          'shendeha@jdcoem.ac.in',
          'harshshende0718@gmail.com',
          'harshxfr@gmail.com',
          'studentrepresentcouncil@jdcoem.ac.in',
          'admin@jdcoem.ac.in',
          'src.president@jdcoem.ac.in',
          'src.mentor@jdcoem.ac.in',
          'src.gensec@jdcoem.ac.in'
        ] ||
        (getAdminAccess() != null && getAdminAccess().role == 'OWNER' && getAdminAccess().active != false) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.active != false) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'COUNCIL_ADMIN'))
      );
    }

    // Legacy Council Admin check
    function isLegacyAdmin() {
      return isHardcodedAdmin() || (
        isAuthenticated() && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'COUNCIL_ADMIN' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER')) ||
          (exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
           get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.active != false)
        )
      );
    }

    function isPrivilegedAdmin() {
      return isOwner() || isLegacyAdmin();
    }

    function isClubOwner() {
      return hasRole('CLUB_OWNER');
    }

    // General admin evaluation across all legacy and current scopes
    function isAdmin() {
      return isPrivilegedAdmin() || getAdminAccess() != null || (
        isAuthenticated() && (
          (exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
           get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.active != false)
        )
      );
    }

    // Verification check for paid registrations (against active checkout sessions or verified UPI ledger)
    function isVerifiedPaidRegistration() {
      return (
        // Case 1: Verified via completed active checkout session with verified received amount
        (request.resource.data.orderId != null &&
         exists(/databases/$(database)/documents/active_checkout_sessions/$(request.resource.data.orderId)) &&
         get(/databases/$(database)/documents/active_checkout_sessions/$(request.resource.data.orderId)).data.status == 'COMPLETED' &&
         get(/databases/$(database)/documents/active_checkout_sessions/$(request.resource.data.orderId)).data.receivedAmount >= get(/databases/$(database)/documents/active_checkout_sessions/$(request.resource.data.orderId)).data.amount) ||
        // Case 2: Verified via verified incoming UPI payments ledger
        (request.resource.data.paymentId != null &&
         exists(/databases/$(database)/documents/verified_upi_payments/$(request.resource.data.paymentId)) &&
         get(/databases/$(database)/documents/verified_upi_payments/$(request.resource.data.paymentId)).data.status == 'MATCHED')
      );
    }

    // Public site content (events, clubs, council, hero, gallery, departments, tenures)
    match /site_content/{docId} {
      allow read: if true;
      allow write: if isPrivilegedAdmin() ||
        (hasRole('PROTOCOL_OFFICER') && (docId == 'src_dispatches' || docId == 'src_dispatch_responses')) ||
        (hasRole('TREASURER') && docId == 'payment_config') ||
        (hasRole('CHIEF_EDITOR') && (docId == 'gallery_photos' || docId == 'gallery_categories')) ||
        (isClubOwner() && (docId == 'clubs' || docId == 'listings'));
    }

    // Individual event documents (1 event = 1 document)
    match /events/{eventId} {
      allow read: if true;
      allow write: if isPrivilegedAdmin() || (isClubOwner() && (
        (request.resource != null && request.resource.data.organizerClubSlug == getAdminAccess().clubSlug) ||
        (request.resource == null && resource.data.organizerClubSlug == getAdminAccess().clubSlug)
      ));
    }

    // Admin authorization records
    match /admins/{email} {
      allow read: if isAuthenticated();
      allow write: if isPrivilegedAdmin();
    }

    // Owner-controlled admin access assignments (keyed by UID, BT ID, or Email)
    match /admin_access/{accessId} {
      allow read: if isAuthenticated();
      allow write: if isOwner() || isPrivilegedAdmin();
    }

    // Student & user profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUserOwner(userId) || isAdmin();
    }

    // Event registrations & pass records
    match /registrations/{regId} {
      // Single pass lookup (/verify/[id] & server checks)
      allow get: if true;

      // Collection queries restricted: Admins can list all; authenticated users can only list queries matching their email/btId
      allow list: if isPrivilegedAdmin() || hasRole('TREASURER') || isClubOwner() || (
        isAuthenticated() && request.auth.token.email != null
      );

      // Registration creation:
      // Allowed for privileged admin or club owner, or student / external applicant with valid email and valid payment state
      allow create: if isPrivilegedAdmin() || isClubOwner() || (
        (isAuthenticated() || (request.resource.data.email is string && request.resource.data.email.size() > 0)) &&
        (
          request.resource.data.paymentStatus in ['FREE', 'PENDING'] ||
          isVerifiedPaidRegistration()
        )
      );

      // Registration updates:
      // Allowed for privileged admins, treasurers, club owners, or self-registered applicants without altering payment status
      allow update: if isPrivilegedAdmin() || hasRole('TREASURER') || isClubOwner() || (
        isAuthenticated() &&
        request.auth.token.email != null &&
        resource.data.email == request.auth.token.email &&
        request.resource.data.paymentStatus == resource.data.paymentStatus
      );

      allow delete: if isPrivilegedAdmin();
    }

    // Active checkout sessions for live UPI QR verification
    match /active_checkout_sessions/{orderId} {
      // Needed for onSnapshot real-time listener in checkout modal
      allow read: if true;

      // Anyone (student or server route) can initiate an active waiting session
      allow create: if isPrivilegedAdmin() || (
        request.resource.data.status == 'WAITING' &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0
      );

      // Updates restricted to prevent arbitrary status escalation:
      // Preserves original orderId, amount, and createdAt, and enforces strict state transitions.
      allow update: if isPrivilegedAdmin() || (
        request.resource.data.orderId == resource.data.orderId &&
        request.resource.data.amount == resource.data.amount &&
        (
          // Transition 1: Expire waiting session
          (resource.data.status == 'WAITING' && request.resource.data.status == 'EXPIRED') ||
          // Transition 2: Complete waiting session with legitimate payment verified in ledger
          (
            resource.data.status == 'WAITING' &&
            request.resource.data.status == 'COMPLETED' &&
            request.resource.data.utr is string &&
            request.resource.data.utr.size() >= 4 &&
            request.resource.data.receivedAmount is number &&
            request.resource.data.receivedAmount >= resource.data.amount &&
            exists(/databases/$(database)/documents/verified_upi_payments/$(request.resource.data.utr)) &&
            get(/databases/$(database)/documents/verified_upi_payments/$(request.resource.data.utr)).data.matchedOrderId == resource.data.orderId
          ) ||
          // Transition 3: Mark failed or dropped from gateway webhook
          (
            resource.data.status == 'WAITING' &&
            request.resource.data.status in ['FAILED', 'DROPPED']
          )
        )
      );

      allow delete: if isPrivilegedAdmin();
    }

    // Verified incoming UPI payments ledger (from phone webhook / MacroDroid)
    match /verified_upi_payments/{utr} {
      // Authenticated users and admins can read; prevents anonymous scraping of bank records
      allow read: if isAuthenticated() || isPrivilegedAdmin();

      // Server routes connect via Client SDK without request.auth:
      // Must contain valid immutable ledger fields (utr, amount, receivedAt)
      allow create: if isPrivilegedAdmin() || (
        request.resource.data.utr is string &&
        request.resource.data.utr == utr &&
        request.resource.data.amount is number &&
        request.resource.data.amount >= 0 &&
        request.resource.data.receivedAt != null
      );

      // Updates can only match orders or link registrations without altering ledger financials
      allow update: if isPrivilegedAdmin() || (
        request.resource.data.utr == resource.data.utr &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.receivedAt == resource.data.receivedAt
      );

      allow delete: if isPrivilegedAdmin();
    }

    // Incoming webhook diagnostic logs
    match /upi_webhook_logs/{logId} {
      allow create: if isPrivilegedAdmin() || (request.resource.data.receivedAt != null);
      allow read, update, delete: if isPrivilegedAdmin();
    }

    // Contact form submissions
    match /contact_submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isPrivilegedAdmin();
    }
  }
}
