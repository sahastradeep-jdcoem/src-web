rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Authentication & Ownership Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUserOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Safety fallback for primary college administrators
    function isHardcodedAdmin() {
      return isAuthenticated() && request.auth.token.email in [
        'shendeha@jdcoem.ac.in',
        'studentrepresentcouncil@jdcoem.ac.in',
        'harshshende0718@gmail.com',
        'harshxfr@gmail.com',
        'admin@jdcoem.ac.in',
        'src.president@jdcoem.ac.in',
        'src.mentor@jdcoem.ac.in',
        'src.gensec@jdcoem.ac.in'
      ];
    }

    // Retrieve user's official college BT ID from /users/{uid}
    function getUserBtId() {
      return (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.btId
        : null;
    }

    // Retrieve active role assignment from /admin_access keyed by UID, BT ID, or Email
    function getAdminAccess() {
      return (isAuthenticated() && exists(/databases/$(database)/documents/admin_access/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/admin_access/$(request.auth.uid)).data
        : (
          (getUserBtId() != null && exists(/databases/$(database)/documents/admin_access/$(getUserBtId())))
            ? get(/databases/$(database)/documents/admin_access/$(getUserBtId())).data
            : (
              (request.auth.token.email != null && exists(/databases/$(database)/documents/admin_access/$(request.auth.token.email)))
                ? get(/databases/$(database)/documents/admin_access/$(request.auth.token.email)).data
                : null
            )
        );
    }

    // Check specific role assignment and ensure it is not deactivated
    function hasRole(roleName) {
      return getAdminAccess() != null &&
        getAdminAccess().role == roleName &&
        getAdminAccess().active != false;
    }

    // Full system Owner identity (break-glass emails, Firestore OWNER role, or appointed Council Admin)
    function isOwner() {
      return isAuthenticated() && (
        request.auth.token.email in [
          'shendeha@jdcoem.ac.in',
          'harshshende0718@gmail.com',
          'harshxfr@gmail.com',
          'studentrepresentcouncil@jdcoem.ac.in',
          'admin@jdcoem.ac.in',
          'src.president@jdcoem.ac.in',
          'src.mentor@jdcoem.ac.in',
          'src.gensec@jdcoem.ac.in'
        ] ||
        (getAdminAccess() != null && getAdminAccess().role == 'OWNER' && getAdminAccess().active != false) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.active != false) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'COUNCIL_ADMIN'))
      );
    }

    // Legacy Council Admin check
    function isLegacyAdmin() {
      return isHardcodedAdmin() || (
        isAuthenticated() && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'COUNCIL_ADMIN' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER')) ||
          (exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
           get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.active != false)
        )
      );
    }

    function isPrivilegedAdmin() {
      return isOwner() || isLegacyAdmin();
    }

    function isSignedIn() {
      return isAuthenticated();
    }

    function isClubOwner() {
      return hasRole('CLUB_OWNER');
    }

    function isEventCoordinator() {
      return hasRole('EVENT_COORDINATOR') || (
        getAdminAccess() != null &&
        getAdminAccess().active != false &&
        getAdminAccess().hasEventCoordinatorAccess == true
      );
    }

    function hasEventsAccess() {
      return isPrivilegedAdmin() || (isClubOwner() && (
        (request.resource != null && (
          request.resource.data.organizerClubSlug == getAdminAccess().clubSlug ||
          (getAdminAccess().clubSlugs is list && request.resource.data.organizerClubSlug in getAdminAccess().clubSlugs)
        )) ||
        (request.resource == null && (
          resource.data.organizerClubSlug == getAdminAccess().clubSlug ||
          (getAdminAccess().clubSlugs is list && resource.data.organizerClubSlug in getAdminAccess().clubSlugs)
        ))
      ));
    }

    // General admin evaluation across all legacy and current scopes
    function isAdmin() {
      return isPrivilegedAdmin() || getAdminAccess() != null || (
        isAuthenticated() && (
          (exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
           get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.active != false)
        )
      );
    }

    // Verification check for paid registrations (against active checkout sessions or verified UPI ledger)
    function isVerifiedPaidRegistration(regId) {
      return (
        // Case 1: Verified via completed active checkout session locked to this registration (or unlinked)
        (request.resource.data.orderId != null &&
         exists(/databases/$(database)/documents/active_checkout_sessions/$(request.resource.data.orderId)) &&
         get(/databases/$(database)/documents/active_checkout_sessions/$(request.resource.data.orderId)).data.status == 'COMPLETED' &&
         get(/databases/$(database)/documents/active_checkout_sessions/$(request.resource.data.orderId)).data.receivedAmount >= get(/databases/$(database)/documents/active_checkout_sessions/$(request.resource.data.orderId)).data.amount &&
         (!('registrationId' in get(/databases/$(database)/documents/active_checkout_sessions/$(request.resource.data.orderId)).data) ||
          get(/databases/$(database)/documents/active_checkout_sessions/$(request.resource.data.orderId)).data.registrationId == null ||
          get(/databases/$(database)/documents/active_checkout_sessions/$(request.resource.data.orderId)).data.registrationId == '' ||
          get(/databases/$(database)/documents/active_checkout_sessions/$(request.resource.data.orderId)).data.registrationId == regId)) ||
        // Case 2: Verified via 1:1 locked incoming UPI payments ledger (must be MATCHED to this registration)
        (request.resource.data.paymentId != null &&
         exists(/databases/$(database)/documents/verified_upi_payments/$(request.resource.data.paymentId)) &&
         get(/databases/$(database)/documents/verified_upi_payments/$(request.resource.data.paymentId)).data.status == 'MATCHED' &&
         get(/databases/$(database)/documents/verified_upi_payments/$(request.resource.data.paymentId)).data.claimedByRegistrationId == regId)
      );
    }

    // Public site content (events, clubs, council, hero, gallery, departments, tenures)
    match /site_content/{docId} {
      allow read: if true;
      allow write: if isPrivilegedAdmin() ||
        (hasRole('PROTOCOL_OFFICER') && (docId == 'src_dispatches' || docId == 'src_dispatch_responses')) ||
        (hasRole('TREASURER') && (docId == 'payment_config' || docId == 'gmail_oauth_config' || docId == 'gmail_oauth_connection')) ||
        (hasRole('CHIEF_EDITOR') && (docId == 'gallery_photos' || docId == 'gallery_categories')) ||
        (isClubOwner() && (docId == 'clubs' || docId == 'listings' || docId == 'certificates_registry' || docId.matches('^cert_logo_.*'))) ||
        (isEventCoordinator() && (docId == 'certificates_registry' || docId.matches('^cert_logo_.*'))) ||
        (docId in ['gmail_oauth_config', 'gmail_oauth_connection']);
    }

    // System Settings & OAuth Configuration
    match /settings/{docId} {
      allow read: if true;
      allow write: if isPrivilegedAdmin() || (docId in ['gmail_oauth_config', 'gmail_oauth_connection']);
    }

    // Individual event documents (1 event = 1 document)
    match /events/{eventId} {
      allow read: if true;
      allow create: if hasEventsAccess();
      allow update: if hasEventsAccess() || (
        isSignedIn() &&
        getUserBtId() != null &&
        resource.data.eventAccessBtIds is list &&
        getUserBtId() in resource.data.eventAccessBtIds
      );
      allow delete: if hasEventsAccess();
    }

    // Admin authorization records
    match /admins/{email} {
      allow read: if isAuthenticated();
      allow write: if isPrivilegedAdmin();
    }

    // Owner-controlled admin access assignments (keyed by UID, BT ID, or Email)
    match /admin_access/{accessId} {
      allow read: if isAuthenticated();
      allow write: if isOwner() || isPrivilegedAdmin();
    }

    // Student & user profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUserOwner(userId) || isAdmin();
      allow delete: if isUserOwner(userId) || isAdmin() || (
        isAuthenticated() &&
        request.auth.token.email != null &&
        resource != null &&
        resource.data.email != null &&
        resource.data.email.lower() == request.auth.token.email.lower() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    // Event registrations & pass records
    match /registrations/{regId} {
      // Single pass lookup (/verify/[id] & server checks)
      allow get: if true;

      // Collection queries restricted: Admins can list all; authenticated users can only list queries matching their email/btId
      allow list: if isPrivilegedAdmin() || hasRole('TREASURER') || isClubOwner() || isEventCoordinator() || (
        isAuthenticated() && request.auth.token.email != null
      );

      // Registration creation:
      // Allowed for privileged admin or club owner, or student / external applicant with valid email and valid payment state
      allow create: if isPrivilegedAdmin() || isClubOwner() || isEventCoordinator() || (
        (isAuthenticated() || (request.resource.data.email is string && request.resource.data.email.size() > 0)) &&
        (
          request.resource.data.paymentStatus in ['FREE', 'PENDING'] ||
          isVerifiedPaidRegistration(regId)
        )
      );

      // Registration updates:
      // Allowed for privileged admins, treasurers, club owners, event coordinators (or signed-in users with a valid BT ID), self-registered applicants without altering payment status, or verified paid registration
      allow update: if isPrivilegedAdmin() || hasRole('TREASURER') || isClubOwner() || isEventCoordinator() || (
        isAuthenticated() &&
        request.auth.token.email != null &&
        resource.data.email == request.auth.token.email &&
        request.resource.data.paymentStatus == resource.data.paymentStatus &&
        (!('amountPaid' in request.resource.data) || !('amountPaid' in resource.data) || request.resource.data.amountPaid == resource.data.amountPaid) &&
        (!('paymentId' in request.resource.data) || !('paymentId' in resource.data) || request.resource.data.paymentId == resource.data.paymentId) &&
        (!('status' in request.resource.data) || !('status' in resource.data) || request.resource.data.status == resource.data.status)
      ) || isVerifiedPaidRegistration(regId);

      allow delete: if isPrivilegedAdmin();
    }

    // Legacy / secondary student_registrations collection mirror
    match /student_registrations/{regId} {
      allow get: if true;
      allow list: if isPrivilegedAdmin() || hasRole('TREASURER') || isClubOwner() || isEventCoordinator() || (
        isAuthenticated() && request.auth.token.email != null
      );
      allow create: if isPrivilegedAdmin() || isClubOwner() || isEventCoordinator() || (
        isAuthenticated() &&
        (
          request.resource.data.paymentStatus in ['FREE', 'PENDING'] ||
          isVerifiedPaidRegistration(regId)
        )
      );
      allow update: if isPrivilegedAdmin() || hasRole('TREASURER') || isClubOwner() || isEventCoordinator() || (
        isAuthenticated() &&
        request.auth.token.email != null &&
        resource.data.email == request.auth.token.email &&
        request.resource.data.paymentStatus == resource.data.paymentStatus &&
        (!('amountPaid' in request.resource.data) || !('amountPaid' in resource.data) || request.resource.data.amountPaid == resource.data.amountPaid) &&
        (!('paymentId' in request.resource.data) || !('paymentId' in resource.data) || request.resource.data.paymentId == resource.data.paymentId) &&
        (!('status' in request.resource.data) || !('status' in resource.data) || request.resource.data.status == resource.data.status)
      ) || isVerifiedPaidRegistration(regId);
      allow delete: if isPrivilegedAdmin();
    }

    // Active checkout sessions for live UPI QR verification
    match /active_checkout_sessions/{orderId} {
      // Needed for onSnapshot real-time listener in checkout modal
      allow read: if true;

      // Anyone (student or server route) can initiate an active waiting session
      allow create: if isPrivilegedAdmin() || (
        request.resource.data.status == 'WAITING' &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0
      );

      // Updates restricted to prevent arbitrary status escalation:
      // Preserves original orderId, amount, and createdAt, and enforces strict state transitions.
      allow update: if isPrivilegedAdmin() || (
        request.resource.data.orderId == resource.data.orderId &&
        request.resource.data.amount == resource.data.amount &&
        (
          // Transition 1: Expire waiting session
          (resource.data.status == 'WAITING' && request.resource.data.status == 'EXPIRED') ||
          // Transition 2: Complete waiting or expired session with legitimate payment verified in ledger
          (
            resource.data.status in ['WAITING', 'EXPIRED'] &&
            request.resource.data.status == 'COMPLETED' &&
            request.resource.data.utr is string &&
            request.resource.data.utr.size() >= 4 &&
            request.resource.data.receivedAmount is number &&
            request.resource.data.receivedAmount >= resource.data.amount &&
            exists(/databases/$(database)/documents/verified_upi_payments/$(request.resource.data.utr)) &&
            get(/databases/$(database)/documents/verified_upi_payments/$(request.resource.data.utr)).data.matchedOrderId == resource.data.orderId
          ) ||
          // Transition 3: Mark failed or dropped from gateway webhook
          (
            resource.data.status == 'WAITING' &&
            request.resource.data.status in ['FAILED', 'DROPPED']
          ) ||
          // Transition 4: Allow linking registrationId or upgrading with Bank SMS UTR on an already-COMPLETED session
          (
            resource.data.status == 'COMPLETED' &&
            request.resource.data.status == 'COMPLETED' &&
            request.resource.data.receivedAmount >= resource.data.amount &&
            (!('registrationId' in resource.data) || resource.data.registrationId == null || resource.data.registrationId == '' || request.resource.data.registrationId == resource.data.registrationId)
          )
        )
      );

      allow delete: if isPrivilegedAdmin();
    }

    // Verified incoming UPI payments ledger (from phone webhook / MacroDroid)
    match /verified_upi_payments/{utr} {
      // Single pass / transaction lookup permitted by exact UTR key
      allow get: if true;

      // Collection queries restricted to authenticated users & admins to prevent scraping
      allow list: if isAuthenticated() || isPrivilegedAdmin();

      // Server routes connect via Client SDK without request.auth:
      // Must contain valid immutable ledger fields (utr, amount, receivedAt)
      allow create: if isPrivilegedAdmin() || (
        request.resource.data.utr is string &&
        request.resource.data.utr == utr &&
        request.resource.data.amount is number &&
        request.resource.data.amount >= 0 &&
        request.resource.data.receivedAt != null
      );

      // Updates can only match orders or link registrations without altering ledger financials
      allow update: if isPrivilegedAdmin() || (
        request.resource.data.utr == resource.data.utr &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.receivedAt == resource.data.receivedAt &&
        (
          !('claimedByRegistrationId' in resource.data) ||
          resource.data.claimedByRegistrationId == null ||
          resource.data.claimedByRegistrationId == '' ||
          request.resource.data.claimedByRegistrationId == resource.data.claimedByRegistrationId
        ) &&
        (
          !('claimedByOrderId' in resource.data) ||
          resource.data.claimedByOrderId == null ||
          resource.data.claimedByOrderId == '' ||
          request.resource.data.claimedByOrderId == resource.data.claimedByOrderId
        )
      );

      allow delete: if isPrivilegedAdmin();
    }

    // Incoming webhook diagnostic logs
    match /upi_webhook_logs/{logId} {
      allow get: if true;
      allow list: if isPrivilegedAdmin();
      allow create, update: if isPrivilegedAdmin() || (request.resource.data.receivedAt != null);
      allow delete: if isPrivilegedAdmin();
    }

    // Contact form submissions
    match /contact_submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isPrivilegedAdmin();
    }

    // Official student certificates & verified digital credentials
    match /certificates/{certId} {
      // Public verification: Anyone who scans the QR code or opens verification URL can view
      allow get: if true;

      // Listing: Privileged admins, club owners, coordinators, or authenticated students
      allow list: if isPrivilegedAdmin() || isClubOwner() || isEventCoordinator() || (
        isAuthenticated() && request.auth.token.email != null
      );

      // Certificate issuance, updates, and revocation
      allow create, update, delete: if isPrivilegedAdmin() || isClubOwner() || isEventCoordinator();
    }

    // Pre-QR 3-slot checkout concurrency queue (managed via server queue API)
    match /checkout_queue/{ticketId} {
      allow read: if true;
      allow create, update: if isPrivilegedAdmin() || (
        request.resource.data.eventId is string &&
        request.resource.data.status in ['QUEUED', 'ADMITTED', 'RELEASED', 'EXPIRED']
      );
      allow delete: if isPrivilegedAdmin() || resource.data.status in ['RELEASED', 'EXPIRED'];
    }
  }
}
